<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <runtime>
    <!--
      打开 .NET Framework 的长路径支持（4.6.2 起可用，本机运行时是 4.8）。

      不打开这两个开关时，Directory.GetFiles / FileStream 遇到超过 260 字符的路径
      会抛 PathTooLongException；而自己加 \\?\ 前缀又会被 FileIOPermission 的
      兼容性检查拒掉，报「路径中具有非法字符」。两个坑都堵在这里。

      Unity 游戏的 StreamingAssets 动辄几百个嵌套目录，很容易撞上 260。
    -->
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
